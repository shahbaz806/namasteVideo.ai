{
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 300
    }
  },
  "queues": {
    "render": {
      "maxRetryAttempts": 3,
      "maxConcurrency": 5,
      "region": "iad1"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
