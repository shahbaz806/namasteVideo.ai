{
  "name": "namastevideo-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "node --env-file-if-exists=.env.local --import tsx src/cli.ts",
    "studio": "remotion studio src/video/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:web && npm test",
    "dev": "npm run dev --workspace=@namastevideo/web",
    "build": "npm run build --workspace=@namastevideo/web",
    "start": "npm run start --workspace=@namastevideo/web",
    "typecheck:web": "npm run typecheck --workspace=@namastevideo/web"
  },
  "dependencies": {
    "@remotion/renderer": "^4.0.0",
    "@vercel/blob": "^0.22.0",
    "@vercel/queue": "^1.0.0",
    "remotion": "^4.0.0",
    "@fontsource/dm-sans": "5.2.6",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "coderabbit": "^0.9.6",
    "mongodb-memory-server": "^8.14.0",
    "mongoose": "^8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/web"
  ]
}
